{
  "name": "blooby",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "npx esbuild src/core/selfcheck.ts --bundle --format=esm | node --input-type=module",

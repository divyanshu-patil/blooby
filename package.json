{
  "name": "blooby",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=./apps/*",
    "dev:web": "turbo run dev --filter=@blooby/web",
    "dev:admin": "turbo run dev --filter=@blooby/admin",
    "dev:api": "turbo run dev --filter=@blooby/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "seed:presets": "pnpm --filter @blooby/api seed:presets",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "ci": "turbo run lint typecheck test",
    "test:coverage": "turbo run test:coverage"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "turbo": "^2.10.12",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5"
}

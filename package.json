{
  "name": "blooby",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=./apps/*",
    "dev:web": "turbo run dev --filter=@blooby/web",
    "dev:admin": "turbo run dev --filter=@blooby/admin",
    "dev:api": "turbo run dev --filter=@blooby/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "seed:presets": "pnpm --filter @blooby/api seed:presets"
  },
  "devDependencies": {
    "oxlint": "^1.75.0",
    "turbo": "^2.10.12",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@10.34.5"
}

# Fake configuration for the unit tests. No secrets: nothing here reaches a network.
# It exists so tests that transitively import config/env.ts get a valid, DETERMINISTIC
# environment in CI, where there is no .env at all.
NODE_ENV=test
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
SUPABASE_URL=https://test.supabase.co
SUPABASE_SECRET_KEY=test-secret-key
SUPABASE_JWKS_URL=https://test.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres.test:test@aws-0-test.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
AWS_REGION=ap-south-1
AWS_S3_BUCKET=test-bucket
AWS_ACCESS_KEY_ID=test-key-id
AWS_SECRET_ACCESS_KEY=test-secret
OLLAMA_URL=https://ollama.test

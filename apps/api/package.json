{
  "name": "@blooby/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/loaders/register.mjs src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx --import ./src/loaders/register.mjs src/index.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed:presets": "tsx scripts/seed-presets.ts",
    "check:copilot": "tsx scripts/check-copilot-keys.ts",
    "collapse:versions": "tsx scripts/collapse-project-versions.ts",
    "check:storage": "tsx scripts/check-project-storage.ts",
    "s3:cors": "tsx scripts/s3-cors.ts",
    "test": "vitest run",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mcp:docs": "tsx --import ./src/loaders/register.mjs scripts/mcp-docs.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:status": "tsx scripts/db-migrate.ts --status",
    "db:migrate:baseline": "tsx scripts/db-migrate.ts --baseline"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@blooby/studio": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.48.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "rate-limit-redis": "^6.0.1",
    "tsx": "^4.19.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.13.3",
    "prisma": "^6.3.0",
    "typescript": "~6.0.2"
  }
}

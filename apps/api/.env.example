# apps/api — server-side only. NEVER commit the filled-in .env.
# Validated at boot by src/config/env.ts; a missing or malformed value stops the server
# with a specific message rather than failing later on a request.

NODE_ENV=development
PORT=3000

APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Where this API is reachable from outside. The MCP server is ${PUBLIC_API_URL}/mcp and this is
# its OAuth issuer. Claude.ai / ChatGPT connect from their own servers, so they need a public
# https URL here (your deployment, or a tunnel such as `cloudflared tunnel --url localhost:3000`).
# Claude Code, Claude Desktop and Cursor on this machine work with localhost.
PUBLIC_API_URL=http://localhost:3000

# How many proxies sit in front of this server. Leave empty with no proxy (development);
# set it to 1 behind a single load balancer (Render, Fly, Heroku, Cloudflare, nginx) so
# rate limits and logs see the real client instead of the proxy. A list works too:
# "loopback, 10.0.0.0/8". Never "true" — that lets a client forge its own address.
TRUST_PROXY=

# --- Supabase -------------------------------------------------------------
# The SECRET key bypasses RLS. Server only, never in a browser bundle.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Prisma's Postgres connection.
#
# TRANSACTION pooler (6543), not the session pooler (5432). Session mode holds one
# Postgres connection per client for the life of the connection and caps the project at
# pool_size 15, so a dev server that restarts on every file save exhausts it within a few
# saves and every request then fails with EMAXCONNSESSION — or, once the pooler starts
# refusing, with a bare "Can't reach database server".
#
# The two query params are not optional:
#   pgbouncer=true      disables prepared statements, which transaction mode cannot keep
#   connection_limit=1  one connection per process; without it Prisma opens (cpus*2+1)
#
# Percent-encode the password: an unescaped @ / : / ? / # in it makes the URL ambiguous,
# and a @ is the common one. @ is %40.
#
# Note the username is postgres.<project-ref>, not plain postgres.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# --- AWS S3 ---------------------------------------------------------------
# Project JSON lives here; Supabase holds only the pointer. The bucket must NOT be
# public — the server reads and writes it, and mints short-lived presigned URLs.
# IAM user scoped to s3:PutObject / s3:GetObject / s3:DeleteObject / s3:ListBucket on
# this bucket only.
AWS_REGION=eu-north-1
AWS_S3_BUCKET=blooby
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

ALLOWED_MEDIA_TYPES=application/json
MAX_PROJECT_BYTES=8388608

# --- Optional -------------------------------------------------------------
# Copilot keys are NOT configured here. They are rows in public.copilot_keys, managed
# from the admin dashboard, so rotating one is not a redeploy and no key is readable by
# anything that can read this process's environment.
OLLAMA_URL=https://ollama.com

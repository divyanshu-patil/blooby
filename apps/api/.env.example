# apps/api — server-side only. NEVER commit the filled-in .env.
# Validated at boot by src/config/env.ts; a missing or malformed value stops the server
# with a specific message rather than failing later on a request.

NODE_ENV=development
PORT=3000

APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Where this API is reachable from outside. The MCP server is ${PUBLIC_API_URL}/mcp and this is
# its OAuth issuer. Claude.ai / ChatGPT connect from their own servers, so they need a public
# https URL here (your deployment, or a tunnel such as `cloudflared tunnel --url localhost:3000`).
# Claude Code, Claude Desktop and Cursor on this machine work with localhost.
PUBLIC_API_URL=http://localhost:3000

# How many proxies sit in front of this server. Leave empty with no proxy (development);
# set it to 1 behind a single load balancer (Render, Fly, Heroku, Cloudflare, nginx) so
# rate limits and logs see the real client instead of the proxy. A list works too:
# "loopback, 10.0.0.0/8". Never "true" — that lets a client forge its own address.
TRUST_PROXY=

# --- Supabase -------------------------------------------------------------
# The SECRET key bypasses RLS. Server only, never in a browser bundle.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Prisma's Postgres connection.
#
# TRANSACTION pooler (6543), not the session pooler (5432). Session mode holds one
# Postgres connection per client for the life of the connection and caps the project at
# pool_size 15, so a dev server that restarts on every file save exhausts it within a few
# saves and every request then fails with EMAXCONNSESSION — or, once the pooler starts
# refusing, with a bare "Can't reach database server".
#
# The two query params are not optional:
#   pgbouncer=true       disables prepared statements, which transaction mode cannot keep
#   connection_limit=10  the pool for this process; without it Prisma opens (cpus*2+1)
#
# Do not set connection_limit=1. It serialises every query in the server onto a single
# connection, so with a round trip of a second or two — any region that is not next to
# you — a page load that fires a handful of requests queues past the 10s pool_timeout and
# the ones at the back die with P2024 "Timed out fetching a new connection". The limit
# that matters is the SESSION pooler's 15 clients (:5432), and this is the transaction
# pooler (:6543), which handles far more. Measured on a link with a ~1.5s round trip,
# four bursts of eight concurrent requests lost 15 of 32 at connection_limit=1 and none
# at 10. If a P2024 still shows up on a bad connection, the next lever is &pool_timeout=30
# — a connection HANDSHAKE costs a round trip too, and the default only allows 10s.
#
# Percent-encode the password: an unescaped @ / : / ? / # in it makes the URL ambiguous,
# and a @ is the common one. @ is %40.
#
# Note the username is postgres.<project-ref>, not plain postgres.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10

# --- Redis (optional) -----------------------------------------------------
# Leave it empty and the API runs as one process with its caches and rate limits in
# memory, which is correct and is how it has always worked. Set it and more than one
# instance agrees on both: a limit of 60 saves a minute means 60, not 60 per instance,
# and a profile or role change is dropped from every instance's cache at once instead of
# waiting out its TTL.
#
# Locally:   docker compose up -d redis     (repo root)
#            REDIS_URL=redis://localhost:6380
#
# On Render: add a Key Value instance and use its INTERNAL url — redis://…, on the
# private network, no TLS, no egress. The external url is rediss:// and works too, but
# leaves the network for no reason. Put it on every service that runs this API.
#
# Redis going down never takes the API with it: commands time out in a second and are
# treated as a cache miss, which is the behaviour from before it existed.
REDIS_URL=

# --- AWS S3 ---------------------------------------------------------------
# Project JSON lives here; Supabase holds only the pointer. The bucket must NOT be
# public — the server reads and writes it, and mints short-lived presigned URLs.
# IAM user scoped to s3:PutObject / s3:GetObject / s3:DeleteObject / s3:ListBucket on
# this bucket only, plus s3:PutBucketCORS / s3:GetBucketCORS if you want to run the
# script below with these credentials.
AWS_REGION=eu-north-1
AWS_S3_BUCKET=blooby
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# THE BUCKET NEEDS CORS RULES. The browser fetches a project's JSON straight from S3
# through a presigned link rather than having it proxied through this server, and a
# bucket refuses a cross-origin read by default — so without this, every project in the
# app fails to open with "No 'Access-Control-Allow-Origin' header is present".
#
#   pnpm --filter @blooby/api s3:cors            # show what is there
#   pnpm --filter @blooby/api s3:cors --apply    # write it
#
# It allows GET and HEAD from APP_URL and ADMIN_URL. Add anything else — preview
# deployments, a second domain — here, comma-separated. A wildcard is fine: CORS is not
# the access control, the presigned signature is, and it names one object and expires.
S3_CORS_ORIGINS=

ALLOWED_MEDIA_TYPES=application/json
MAX_PROJECT_BYTES=8388608

# --- Optional -------------------------------------------------------------
# Copilot keys are NOT configured here. They are rows in public.copilot_keys, managed
# from the admin dashboard, so rotating one is not a redeploy and no key is readable by
# anything that can read this process's environment.
OLLAMA_URL=https://ollama.com

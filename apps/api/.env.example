# apps/api — server-side only. NEVER commit the filled-in .env.
# Validated at boot by src/config/env.ts; a missing or malformed value stops the server
# with a specific message rather than failing later on a request.

NODE_ENV=development
PORT=8787

APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# --- Supabase -------------------------------------------------------------
# The SECRET key bypasses RLS. Server only, never in a browser bundle.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Prisma's direct Postgres connection.
# Dashboard -> Project Settings -> Database -> Connection string -> Session pooler (5432).
# Note the username is postgres.<project-ref>, not plain postgres.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- AWS S3 ---------------------------------------------------------------
# Project JSON lives here; Supabase holds only the pointer. The bucket must NOT be
# public — the server reads and writes it, and mints short-lived presigned URLs.
# IAM user scoped to s3:PutObject / s3:GetObject / s3:DeleteObject / s3:ListBucket on
# this bucket only.
AWS_REGION=eu-north-1
AWS_S3_BUCKET=blooby
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

ALLOWED_MEDIA_TYPES=application/json
MAX_PROJECT_BYTES=8388608

# --- Optional -------------------------------------------------------------
# Ollama Cloud keys for POST /api/copilot/chat, tried in order on failure.
OLLAMA_KEYS=
OLLAMA_URL=https://ollama.com

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@blooby/web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/projects/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|LinkedInBot|WhatsApp|TelegramBot|Pinterest|redditbot|Applebot|Googlebot|bingbot|DuckDuckBot|SkypeUriPreview|vkShare|embedly|Iframely|quora link preview|nuzzel|Bitrix|XING-contenttabreceiver|Mastodon|Bluesky).*"
        }
      ],
      "destination": "https://blooby-l35k.onrender.com/og/projects/:id"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
